rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Match shops collection and all subcollections (store, customer_display, etc.)
    match /shops/{shopId} {
      allow read, write: if isValidId(shopId);
      match /{allSubcollections=**} {
        allow read, write: if isValidId(shopId);
      }
    }

    // Match health check and connection test doc
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
