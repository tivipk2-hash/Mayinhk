rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate document IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /shops/{shopId}/store/{storeDoc} {
      allow read, write: if isValidId(shopId) && isValidId(storeDoc);
    }

    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
